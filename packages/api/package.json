{
  "name": "@wiktapi/api",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "benchmark": "node scripts/benchmark_api.ts",
    "dev": "nitro dev",
    "preview": "npx srvx --prod .output/",
    "test": "vp test run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "download": "node scripts/download_kaikki.ts",
    "import": "node scripts/import_data.ts",
    "refresh": "node scripts/refresh_database.ts",
    "import:staging": "node scripts/import_data.ts --output data/wiktionary.db.new --fresh --require-all-editions",
    "index": "node scripts/build_indexes.ts",
    "index:staging": "node scripts/build_indexes.ts --output data/wiktionary.db.new --require-all-editions",
    "validate:staging": "node scripts/validate_database.ts --output data/wiktionary.db.new --require-all-editions",
    "swap": "node scripts/swap_database.ts",
    "rollback": "node scripts/rollback_database.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "effect": "^3.19.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "nitro": "latest",
    "rolldown": "latest",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
